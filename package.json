{
  "name": "dsh-session-fts",
  "version": "0.1.0",
  "description": "Local full-text session search with CJK-aware matching and time-range filters",
  "license": "MIT",
  "author": "xuhuaiqu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuhuaiqu/dsh-session-fts.git"
  },
  "homepage": "https://github.com/xuhuaiqu/dsh-session-fts#readme",
  "bugs": {
    "url": "https://github.com/xuhuaiqu/dsh-session-fts/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "session-search",
    "full-text-search",
    "sqlite",
    "fts5",
    "cjk"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.5": "compatible"
      }
    }
  }
}
