{
  "name": "dsh-session-fts",
  "version": "0.3.5-zzl.1",
  "description": "Local layered title, CJK full-text and multilingual semantic session search",
  "license": "MIT",
  "author": "xuhuaiqu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeeliN221/dsh-session-fts.git"
  },
  "homepage": "https://github.com/DeeliN221/dsh-session-fts#readme",
  "bugs": {
    "url": "https://github.com/DeeliN221/dsh-session-fts/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "session-search",
    "full-text-search",
    "sqlite",
    "fts5",
    "cjk"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.5": "compatible"
      }
    }
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "proper-lockfile": "4.1.2",
    "sqlite-vec": "0.1.9"
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check host/semantic-worker.js",
    "bench": "node --expose-gc tests/search.perf.mjs",
    "test:semantic": "node tests/semantic-smoke.js",
    "test:lifecycle": "node --test tests/lifecycle.cordis.mjs"
  }
}
